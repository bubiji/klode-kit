#!/bin/sh
# klode-kit launcher.
# V2: locate the repository and its .venv from this script's REAL path (symlinks resolved);
#     no absolute paths are written here. A missing or non-runnable venv python is exit 40
#     with the fix command - never a silent fallback to some other python.
# V1: run `<venv>/bin/python -m klode_kit`, never a venv console script.
# V3: PYTHONPATH=<repo>/src, so an editable-install .pth pointing elsewhere cannot win.
# KLODE_KIT_PYTHON overrides the interpreter (it is checked the same way).
set -u

resolve() {
    p=$1
    while [ -L "$p" ]; do
        link=$(readlink "$p")
        case $link in
            /*) p=$link ;;
            *) p=$(dirname "$p")/$link ;;
        esac
    done
    dir=$(cd -P "$(dirname "$p")" 2>/dev/null && pwd -P) || return 1
    printf '%s/%s\n' "$dir" "$(basename "$p")"
}

self=$(resolve "$0") || { echo "klode-kit: cannot resolve launcher path: $0" >&2; exit 40; }
root=$(dirname "$(dirname "$self")")

if [ -n "${KLODE_KIT_PYTHON:-}" ]; then
    py=$KLODE_KIT_PYTHON
    source_desc="KLODE_KIT_PYTHON"
else
    py=$root/.venv/bin/python
    source_desc="repository .venv"
fi

if ! "$py" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 12) else 1)' >/dev/null 2>&1; then
    {
        echo "klode-kit: python from $source_desc is missing or cannot run (needs >= 3.12): $py"
        echo "  fix: $root/scripts/install.sh"
    } >&2
    exit 40
fi

PYTHONPATH="$root/src${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONPATH
exec "$py" -m klode_kit "$@"
