{
  "title": "klode-kit 工作流（通用版）",
  "title_en": "klode-kit pipeline (generic)",
  "source": "02-概要设计.md r2.3 状态机、r2.8 三回路、r2.9 阶段表、r3.2 发布、r4.1 effective/candidates。Workflow 两段式：audit 生成确认页即结束（exit 10），点选后 resume 进入 writeback。唯一人工步骤是点选。 状态机 extracted → pending_confirm → verified | disputed。写回只写候选 candidate；仅候选 verified 时推进 effective；disputed 或重做失败时 effective 不动；无分歧且全路齐的候选直接 verified(auto)；缺路页候选直接 disputed；build 只读 effective。",
  "roles": [
    {"id": "user", "zh": "用户", "en": "User", "human": true},
    {"id": "pipeline", "zh": "pipeline.py", "en": "Pipeline script"},
    {"id": "local", "zh": "本机读图引擎", "en": "Local OCR engines"},
    {"id": "cloud", "zh": "云端读图模型", "en": "Cloud vision models"},
    {"id": "writer", "zh": "写卡 agent", "en": "Card-writer agent"},
    {"id": "klode", "zh": "klode CLI", "en": "klode CLI"}
  ],
  "artifacts": [
    {"id": "preflight_receipt", "kind": "report", "zh": "体检 receipt", "en": "Preflight receipt"},
    {"id": "inbox", "kind": "data", "zh": "待处理图", "en": "Input images"},
    {"id": "manifest", "kind": "data", "zh": "manifest", "en": "Manifest"},
    {"id": "masked", "kind": "data", "zh": "打码图", "en": "Masked images"},
