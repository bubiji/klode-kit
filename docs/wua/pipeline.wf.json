    {"id": "ocr_cloud", "kind": "data", "zh": "云端 JSONL", "en": "Cloud JSONL"},
    {"id": "rec_extracted", "kind": "data", "zh": "extracted", "en": "Record extracted", "state": "extracted"},
    {"id": "whitelist", "kind": "checklist", "zh": "弱点白名单", "en": "Weakness list"},
    {"id": "rec_pending", "kind": "data", "zh": "pending_confirm", "en": "Record pending", "state": "pending_confirm"},
    {"id": "crops", "kind": "data", "zh": "分歧小图", "en": "Crops"},
    {"id": "confirm_page", "kind": "artifact", "zh": "确认页", "en": "Confirm page"},
    {"id": "choices", "kind": "data", "zh": "choices.json", "en": "choices.json"},
    {"id": "rev_note", "kind": "template", "zh": "候选·生效说明", "en": "candidate vs effective"},
    {"id": "fixes", "kind": "data", "zh": "fixes.jsonl", "en": "fixes.jsonl"},
