    {"id": "rec_disputed", "kind": "data", "zh": "disputed", "en": "Record disputed", "state": "disputed"},
    {"id": "txt", "kind": "data", "zh": "导出 txt", "en": "Export txt"},
    {"id": "skeleton", "kind": "data", "zh": "L0 骨架", "en": "L0 skeleton"},
    {"id": "cards", "kind": "artifact", "zh": "卡片草稿", "en": "Card drafts"},
    {"id": "gate1", "kind": "report", "zh": "门禁 1 报告", "en": "Gate 1 report"},
    {"id": "library", "kind": "data", "zh": "发布卡", "en": "Published cards"},
    {"id": "strict_report", "kind": "report", "zh": "strict 报告", "en": "Strict report"},
    {"id": "desk", "kind": "artifact", "zh": "书桌", "en": "Desk"},
    {"id": "desk_report", "kind": "report", "zh": "路由报告", "en": "Routing report"},
    {"id": "expert", "kind": "code", "zh": "expert agent", "en": "Expert agent"},
    {"id": "build_receipt", "kind": "report", "zh": "build receipt", "en": "build receipt"},
    {"id": "check_receipt", "kind": "report", "zh": "check receipt", "en": "check receipt"},
    {"id": "publish_receipt", "kind": "report", "zh": "publish receipt", "en": "publish receipt"}
  ],
  "steps": [
    {"id": "preflight", "stage": "preflight", "zh": "环境体检", "en": "Preflight", "role": "pipeline", "out": ["preflight_receipt"]},
    {"id": "orient", "stage": "ocr", "zh": "转正", "en": "Rotate", "role": "pipeline", "in": ["inbox"], "refers_to": ["preflight_receipt"], "out": ["manifest"]},
    {"id": "mask", "stage": "ocr", "zh": "抬头打码", "en": "Mask", "role": "pipeline", "in": ["manifest"], "out": ["masked"]},
    {"id": "ocr_local", "stage": "ocr", "zh": "本机两路", "en": "Local OCR", "role": "local", "in": ["manifest"], "out": ["ocr_local"]},
    {"id": "ocr_cloud", "stage": "ocr", "zh": "云端两路", "en": "Cloud OCR", "role": "cloud", "in": ["masked"], "out": ["ocr_cloud"]},
    {"id": "extract", "stage": "audit", "zh": "抽字段", "en": "Extract", "role": "pipeline", "in": ["ocr_local", "ocr_cloud"], "out": ["rec_extracted"]},
    {"id": "compare", "stage": "audit", "zh": "字段比对", "en": "Compare", "role": "pipeline", "in": ["rec_extracted"], "refers_to": ["whitelist"], "out": ["rec_pending"]},
    {"id": "crop", "stage": "audit", "zh": "裁小图", "en": "Crop", "role": "pipeline", "in": ["rec_pending"], "out": ["crops"]},
    {"id": "confirm", "stage": "audit", "zh": "生成确认页", "en": "Confirm page", "role": "pipeline", "in": ["crops"], "out": ["confirm_page"]},
    {"id": "pick", "stage": "audit", "zh": "逐条点选", "en": "Pick", "role": "user", "in": ["confirm_page"], "out": ["choices"]},
    {"id": "writeback", "stage": "writeback", "zh": "写回", "en": "Write back", "role": "pipeline", "in": ["choices", "rec_pending"], "refers_to": ["rev_note"], "out": ["fixes", "rec_verified", "rec_disputed"]},
    {"id": "export", "stage": "build", "zh": "脱敏导出", "en": "Export", "role": "pipeline", "in": ["rec_verified"], "out": ["txt"]},
    {"id": "klode_build", "stage": "build", "zh": "klode build", "en": "klode build", "role": "klode", "in": ["txt"], "out": ["skeleton"]},
    {"id": "dispatch", "stage": "build", "zh": "写卡 + 门禁 1", "en": "Write + gate 1", "role": "writer", "in": ["skeleton"], "out": ["cards", "gate1"]},
    {"id": "write_card", "stage": "build", "zh": "write_card", "en": "write_card", "role": "klode", "in": ["cards"], "out": ["library"]},
    {"id": "strict", "stage": "build", "zh": "strict", "en": "strict", "role": "klode", "in": ["library"], "out": ["strict_report"]},
    {"id": "desk", "stage": "build", "zh": "书桌蒸馏", "en": "Desk", "role": "pipeline", "in": ["library"], "out": ["desk"]},
    {"id": "desk_verify", "stage": "build", "zh": "路由测试", "en": "Route test", "role": "pipeline", "in": ["desk"], "out": ["desk_report"]},
    {"id": "gen_agent", "stage": "build", "zh": "生成 expert", "en": "Gen expert", "role": "pipeline", "in": ["desk_report"], "out": ["expert", "build_receipt"]},
    {"id": "check", "stage": "check", "zh": "全库检查", "en": "Check", "role": "pipeline", "in": ["build_receipt", "expert"], "out": ["check_receipt"]},
    {"id": "publish", "stage": "publish", "zh": "发布", "en": "Publish", "role": "pipeline", "in": ["check_receipt"], "out": ["publish_receipt"]}
  ],
  "loops": [
    {"id": "L1", "from": "desk_verify", "to": "desk", "zh": "L1 路由不足 → 书桌", "en": "L1 routing → desk"},
    {"id": "L2", "from": "strict", "to": "dispatch", "zh": "L2 NOT FOUND → 重派写卡", "en": "L2 not found → rewrite"},
    {"id": "L3", "from": "strict", "to": "write_card", "zh": "L3 锚点失效 → 回写卡", "en": "L3 citation-rot → write_card"}
  ]
}
